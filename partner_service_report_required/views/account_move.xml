<odoo>
    <record id="view_move_form_service_report" model="ir.ui.view">
        <field name="name">Add Requires Service Report to account move form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="requires_service_report" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
